# Build with APP_ENV=production only when the Supabase values are supplied.
APP_ENV=staging
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SHOP_NAME=متجر أعلاف ومستلزمات الحيوانات
APP_DOWNLOAD_LINK=https://example.com/download
APK_LINK=https://example.com/downloads/animal-supply-b2b.apk
SUPPORT_WHATSAPP=+218910000000

# Firebase public client configuration is optional until push is enabled.
# These are build-time values, not service credentials.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=ly.animalsupply.b2b
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# Never put SUPABASE_SERVICE_ROLE_KEY, FIREBASE_SERVICE_ACCOUNT_JSON, or
# NOTIFICATION_DISPATCH_SECRET in Flutter or any shipped mobile/web file.
